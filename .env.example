# Environment-variable reference. The Python service reads process variables;
# it does not automatically load this root file.

# Optional path to a valid computed Fidelity JSON report. Relative paths are
# resolved from the repository root. This is the API's default, so the variable
# can be omitted for a standard pipeline run.
FIDELITY_REPORT_PATH=artifacts/latest-report.json

# Server-only origin used by the Next.js `/runs/latest` route. Put this entry in
# `web/.env.local` for local development, or set it in the web process. Do not
# rename it to a NEXT_PUBLIC variable; the browser does not need the API origin.
FIDELITY_API_BASE_URL=http://127.0.0.1:8000
